{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["github>OidaTiftla/renovate-config"],
  "enabledManagers": ["npm", "github-actions", "devcontainer", "custom.regex"],
  // Run Renovate hourly on Mondays.
  "schedule": ["0 * * * 1"],
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": ["/^src\\/mcp-versions\\.json$/"],
      "matchStrings": [
        "\\\"package\\\"\\s*:\\s*\\\"(?<depName>Microsoft\\.GitHubCopilot\\.Upgrade(?:\\.DotNet)?\\.Mcp)\\\"\\s*,\\s*\\\"version\\\"\\s*:\\s*\\\"(?<currentValue>[^\\\"]+)\\\""
      ],
      "datasourceTemplate": "nuget",
      "versioningTemplate": "nuget"
    },
    {
      "customType": "regex",
      "managerFilePatterns": ["/^src\\/mcp-versions\\.json$/"],
      "matchStrings": [
        "\\\"package\\\"\\s*:\\s*\\\"(?<depName>@microsoft\\/jsts-upgrade-assistant)\\\"\\s*,\\s*\\\"version\\\"\\s*:\\s*\\\"(?<currentValue>[^\\\"]+)\\\""
      ],
      "datasourceTemplate": "npm",
      "versioningTemplate": "npm"
    },
    {
      "customType": "regex",
      "managerFilePatterns": ["/^src\\/(?:node|dotnet)-version\\.ts$/"],
      "matchStrings": [
        "// renovate: datasource=(?<datasource>[^\\s]+) depName=(?<depName>[^\\s]+) versioning=(?<versioning>[^\\s]+)\\s+export const [A-Z_]+_VERSION = \\\"(?<currentValue>[^\\\"]+)\\\";"
      ]
    }
  ],
  "packageRules": [
    {
      "matchManagers": ["npm", "github-actions", "devcontainer"],
      "automerge": true,
      "platformAutomerge": true,
      "automergeStrategy": "rebase",
      "ignoreTests": false
    },
    {
      "description": "Keep tested Upgrade MCP package pins compatible.",
      "matchManagers": ["custom.regex"],
      "matchPackageNames": [
        "Microsoft.GitHubCopilot.Upgrade.Mcp",
        "Microsoft.GitHubCopilot.Upgrade.DotNet.Mcp",
        "@microsoft/jsts-upgrade-assistant"
      ],
      "groupName": "Upgrade MCP compatibility stack",
      "automerge": false,
      "ignoreTests": false
    },
    {
      "description": "Keep the Node.js runtime declarations synchronized.",
      "matchPackageNames": ["node"],
      "groupName": "Node.js runtime",
      "automerge": true,
      "platformAutomerge": true,
      "automergeStrategy": "rebase",
      "ignoreTests": false
    },
    {
      "description": "Require approval for Node.js major upgrades.",
      "matchPackageNames": ["node"],
      "matchUpdateTypes": ["major"],
      "automerge": false,
      "platformAutomerge": false
    },
    {
      "description": "Keep the .NET runtime declarations synchronized.",
      "matchPackageNames": ["mcr.microsoft.com/dotnet/sdk"],
      "groupName": ".NET runtime",
      "ignoreTests": false
    }
  ]
}
